{
  "name": "debughawk/debughawk-plugin",
  "type": "wordpress-plugin",
  "authors": [
    {
      "name": "Ashley Rich",
      "email": "hello@ashleyrich.com"
    }
  ],
  "require": {
    "php": "^7.4|^8.0"
  },
  "autoload": {
    "psr-4": {
      "DebugHawk\\": "src/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "autoload-dev": {
    "psr-4": {
      "DebugHawk\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
